# Zettelwirtschaft - Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.

# Frontend-Port (Default: 8080)
FRONTEND_PORT=8080

# Datenbank
# DATABASE_URL=sqlite+aiosqlite:///./data/zettelwirtschaft.db

# Verzeichnisse
# UPLOAD_DIR=./data/uploads
# WATCH_DIR=./data/watch          # Eingangsordner: neue Dateien hier werden automatisch verarbeitet
# ARCHIVE_DIR=./data/archive
# EXPORT_DIR=                     # Zielordner fuer verarbeitete Dokumente (leer = deaktiviert)
                                  # z.B. EXPORT_DIR=/mnt/nas/dokumente oder C:/Users/Name/Dokumente/Archiv

# Ollama (lokales LLM)
OLLAMA_BASE_URL=http://ollama:11434
# Default: gemma4:e2b-it-qat (4,3 GB, laeuft auch auf der CPU).
# NVIDIA-GPU mit >= 10 GB VRAM: gemma4:12b-it-qat (genauer, 7,2 GB).
# Bisheriger Default (bis v1.5): qwen2.5:7b-instruct.
# Benoetigt Ollama >= 0.30.3 (getestet mit 0.40.5).
OLLAMA_MODEL=gemma4:e2b-it-qat

# Upload-Limits
# MAX_UPLOAD_SIZE_MB=50
# ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff,bmp

# OCR
# OCR_LANGUAGES=deu+eng
# MAX_OCR_PAGES=10

# KI-Analyse
# Fehlende Modelle (OLLAMA_MODEL, EMBEDDING_MODEL) laedt das Backend beim Start
# selbst herunter; der Systemstatus zeigt "wird heruntergeladen" bzw. "fehlt".
# OLLAMA_TIMEOUT=300
# OLLAMA_ANALYSIS_TIMEOUT=120     # Timeout (s) der JSON-Dokumentanalyse
# OLLAMA_NUM_CTX=8192             # Kontextfenster
# OLLAMA_NUM_PREDICT=1024         # max. Antwort-Tokens der Analyse
# OLLAMA_KEEP_ALIVE=30m           # Modell nach einem Aufruf so lange geladen halten
# OLLAMA_THINK=false              # nur fuer Modelle mit "thinking"-Faehigkeit
# OLLAMA_MAX_RETRIES=2
# CONFIDENCE_THRESHOLD=0.7

# E-Mail-Import
# IMAP_TIMEOUT=30                 # Socket-Timeout (s)
# EMAIL_MAX_PER_RUN=25            # max. E-Mails pro Abruf, Rest beim naechsten Lauf

# Logging
# LOG_LEVEL=INFO

# Zeitzone fuer CRON-Zeitplaene der E-Mail-Konten (Ortszeit statt UTC)
# TIMEZONE=Europe/Berlin

# Festes Subnetz des Docker-Netzes nginx -> Backend (Default 172.31.250.0/24).
# Nur aendern, wenn "docker compose up" mit "Pool overlaps" abbricht.
# ZW_PROXY_SUBNET=172.31.250.0/24

# Backup
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4

# PIN-Schutz (optional)
PIN_ENABLED=false
PIN_CODE=

# ChromaDB / RAG (KI-Assistent)
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
# Default: qwen3-embedding:4b (beste Suchtreffer, 2,5 GB).
# Bei weniger als 12 GB RAM: qwen3-embedding:0.6b (passt neben dem LLM).
# Bisheriger Default (bis v1.5): bge-m3. Ein Wechsel baut den Vektor-Index
# beim naechsten Start automatisch neu auf (eigene Collection pro Modell).
EMBEDDING_MODEL=qwen3-embedding:4b
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=5

# E-Mail-Verschluesselungsschluessel (Pflicht fuer E-Mail-Anbindung).
# Generieren mit:
# docker compose exec backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=

# Update-Pruefung (opt-in, telemetriefrei). Standardmaessig AUS — ohne
# Aktivierung in den Einstellungen macht die App keinen externen Aufruf.
# Dies ist nur der Default; der Laufzeit-Schalter liegt in der DB.
# UPDATE_CHECK_ENABLED=false
# UPDATE_MANIFEST_URL=https://zettelwirtschaft.mr-development.de/latest.json
