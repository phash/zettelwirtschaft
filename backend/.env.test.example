# Lokale Test-Zugangsdaten fuer die Backend-Tests (pytest).
#
# Optional: ohne backend/.env.test erzeugt tests/credentials.py die Werte
# einmal pro Test-Lauf zufaellig. Wer feste lokale Werte will:
#
#   cp .env.test.example .env.test      (PowerShell: Copy-Item .env.test.example .env.test)
#
# und die Platzhalter ersetzen. .env.test ist gitignored — NIE committen.
# Umgebungsvariablen gleichen Namens haben Vorrang vor dieser Datei.
#
# Neuen Fernet-Key erzeugen:
#   .venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Nur Ziffern, mindestens 4 Stellen (Installer: 6).
TEST_PIN=
# Zwei unterschiedliche Dummy-IMAP-Passwoerter (Anlegen bzw. Aendern eines Kontos).
TEST_IMAP_PASSWORD=
TEST_IMAP_PASSWORD_2=
# Gueltiger Fernet-Key (44 Zeichen, URL-safe Base64).
TEST_EMAIL_ENCRYPTION_KEY=
# Dummy-Zugangsdaten einer gefaelschten SMB-Freigabe (Netzwerkordner-Tests; es wird
# nie eine echte Verbindung aufgebaut). Zwei unterschiedliche Passwoerter, mind. 12 Zeichen.
TEST_SMB_USER=
TEST_SMB_PASSWORD=
TEST_SMB_PASSWORD_2=
