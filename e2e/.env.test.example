# Lokale Test-Zugangsdaten fuer die E2E-Tests (Playwright).
#
# Optional: ohne e2e/.env.test erzeugt helpers/credentials.ts die Werte pro
# Lauf zufaellig (in playwright.config.ts, die Worker erben sie). Fuer feste
# lokale Werte:
#
#   cp .env.test.example .env.test      (PowerShell: Copy-Item .env.test.example .env.test)
#
# und die Platzhalter ersetzen. .env.test ist gitignored — NIE committen.
# Umgebungsvariablen gleichen Namens haben Vorrang vor dieser Datei.

# Nur Ziffern, mindestens 4 Stellen (Installer: 6).
TEST_PIN=
# Zwei unterschiedliche Dummy-IMAP-Passwoerter (Anlegen bzw. Aendern eines Kontos).
TEST_IMAP_PASSWORD=
TEST_IMAP_PASSWORD_2=
