# Lokale Test-Zugangsdaten fuer scripts/test-scripts.ps1.
#
# Optional: ohne scripts\.env.test erzeugt test-scripts.ps1 die Werte pro Lauf
# zufaellig. Fuer feste lokale Werte:
#
#   Copy-Item scripts\.env.test.example scripts\.env.test
#
# und die Platzhalter ersetzen. .env.test ist gitignored - NIE committen.
# Umgebungsvariablen gleichen Namens haben Vorrang vor dieser Datei.

# Nur Ziffern, mindestens 4 Stellen (Installer: 6).
TEST_PIN=
# Fernet-Key: 43 URL-safe-Base64-Zeichen + "=".
TEST_EMAIL_ENCRYPTION_KEY=
