# Zettelwirtschaft - Native-Konfiguration (Windows)
# Das Setup schreibt die echte Datei nach <Datenordner>\config.toml
# (Default: %USERPROFILE%\Documents\Zettelwirtschaft\config.toml; der Pfad steht
# in HKLM\SOFTWARE\Zettelwirtschaft -> ConfigPath). Diese Datei ist nur eine
# kommentierte Vorlage. Das Backend liest ZETTELWIRTSCHAFT_CONFIG als Pfad zur
# aktuellen Datei (vom Installer im Service-ENV gesetzt).
#
# Aenderungen werden nach Service-Neustart wirksam.

# ---- HTTP-Server ----
# host = "0.0.0.0" macht das Frontend aus dem LAN erreichbar
# (Windows-Firewall-Regel wird vom Installer eingerichtet).
# Setze host = "127.0.0.1" um Zettelwirtschaft nur lokal nutzbar zu machen.
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 8080

# ---- HTTPS (optional, fuer Smartphone-Scan im LAN) ----
# Die Kamera-API und der PWA-Service-Worker verlangen einen Secure Context
# (HTTPS oder localhost). Das Native-Bundle enthaelt keinen Zertifikats-
# Generator; cert.pem + key.pem z.B. auf einem Rechner mit Python erzeugen:
#   python ssl\generate-self-signed-cert.py <LAN-IP> <Zielordner>
# (Skript aus dem Quellcode-Repository, braucht das Paket "cryptography").
# Dann beide Pfade setzen (leer = HTTP) und den Dienst neu starten:
# SERVER_SSL_CERTFILE = "C:/Users/<USER>/Documents/Zettelwirtschaft/ssl/cert.pem"
# SERVER_SSL_KEYFILE  = "C:/Users/<USER>/Documents/Zettelwirtschaft/ssl/key.pem"

# ---- Datenbank + Verzeichnisse ----
# Diese Pfade duerfen absolut oder relativ sein. Bei einem Setup-Run schreibt
# der Installer hier in der Regel absolute Pfade zum gewaehlten Datenordner.
DATABASE_URL = "sqlite+aiosqlite:///C:/Users/<USER>/Documents/Zettelwirtschaft/data/zettelwirtschaft.db"
UPLOAD_DIR = "C:/Users/<USER>/Documents/Zettelwirtschaft/data/uploads"
ARCHIVE_DIR = "C:/Users/<USER>/Documents/Zettelwirtschaft/data/archive"
THUMBNAIL_DIR = "C:/Users/<USER>/Documents/Zettelwirtschaft/data/thumbnails"
WATCH_DIR = "C:/Users/<USER>/Documents/Zettelwirtschaft/data/watch"
EXPORT_DIR = ""  # leer = deaktiviert. z.B. "D:/Steuerberater/Eingang" (lokaler Ordner).
# Netzwerkordner (NAS): in der Web-UI unter Einstellungen > Ordner den Pfad
# \\server\freigabe\ordner mit Benutzer und Passwort der Freigabe eintragen. Der
# Dienst verbindet sich dann selbst. Netzlaufwerke (V:) sieht der Dienst nicht.
# Experten-Override: UNC OHNE Zugangsdaten erlauben (der Dienst meldet dann das
# Computerkonto am Server an - nur mit einer vertrauenswuerdigen Freigabe).
# ALLOW_NETWORK_FOLDERS = false
# Pruefintervall fuer Netzwerk-Watch-Ordner in Sekunden (10-600), falls in der UI
# nichts gespeichert ist.
# WATCH_POLL_INTERVAL = 30
# Auch lokale Watch-Ordner per Polling ueberwachen (z.B. Docker mit CIFS-Volume).
# WATCH_FORCE_POLLING = false

# ---- KI / Ollama ----
OLLAMA_BASE_URL = "http://localhost:11434"  # Native-Default (vom Ollama-Service auf localhost)
# Default gemma4:e2b-it-qat (4,3 GB, CPU-tauglich); NVIDIA-GPU mit >= 10 GB VRAM:
# gemma4:12b-it-qat. Bisheriger Default (bis v1.5): qwen2.5:7b-instruct.
# Benoetigt Ollama >= 0.30.3 (getestet mit 0.40.5).
OLLAMA_MODEL = "gemma4:e2b-it-qat"
# Fehlende Modelle (OLLAMA_MODEL, EMBEDDING_MODEL) laedt das Backend beim Start selbst
# aus der Ollama-Registry (einzige automatische Internet-Verbindung: Modellname + IP).
# Abschalten mit OLLAMA_AUTO_PULL = false (dann `ollama pull <modell>` von Hand).
OLLAMA_AUTO_PULL = true
OLLAMA_TIMEOUT = 300
OLLAMA_MAX_RETRIES = 2
# OLLAMA_ANALYSIS_TIMEOUT = 120   # Timeout (s) der JSON-Dokumentanalyse
# OLLAMA_NUM_CTX = 8192           # Kontextfenster
# OLLAMA_NUM_PREDICT = 1024       # max. Antwort-Tokens der Analyse
# OLLAMA_KEEP_ALIVE = "30m"       # Modell nach einem Aufruf so lange geladen halten
# OLLAMA_THINK = false            # nur fuer Modelle mit "thinking"-Faehigkeit

# ---- E-Mail-Import ----
# IMAP_TIMEOUT = 30               # Socket-Timeout (s)
# EMAIL_MAX_PER_RUN = 25          # max. E-Mails pro Abruf, Rest beim naechsten Lauf

# ---- OCR ----
OCR_LANGUAGES = "deu+eng"
CONFIDENCE_THRESHOLD = 0.7
MAX_OCR_PAGES = 10

# Mehrdokument-Scans aufteilen (automatische Pruefung, Upload-Option, "Dokument aufteilen")
# SPLIT_AUTO_ENABLED = true      # PDFs vor der Analyse auf mehrere Dokumente pruefen (UI: System -> Verarbeitung)
# SPLIT_MIN_PAGES = 3            # ab dieser Seitenzahl automatisch pruefen (mindestens 2)
# SPLIT_USE_LLM = true           # unsichere Uebergaenge zusaetzlich per KI pruefen (ein Aufruf je Stapel)
# SPLIT_MAX_PAGES = 100          # darueber keine Aufteilung (normale Verarbeitung)
# SPLIT_TIME_BUDGET_S = 1200     # Zeitbudget der Seitenerkennung je Stapel
# SPLIT_BLANK_INK = 0.005        # Anteil dunkler Pixel, unter dem eine Seite leer ist
# SPLIT_MAX_PARTS = 50           # hoechstens so viele Teile je Stapel
# SPLIT_KEEP_SOURCE_DAYS = 30    # Stapeldatei nach Abschluss so lange aufbewahren
# SPLIT_THUMBNAIL_WIDTH = 200    # Breite der Seiten-Vorschaubilder (px)

# ---- Upload-Limits ----
MAX_UPLOAD_SIZE_MB = 50
ALLOWED_FILE_TYPES = "pdf,jpg,jpeg,png,tiff,bmp"

# ---- Logging ----
LOG_LEVEL = "INFO"

# ---- Zeitzone ----
# Fuer CRON-Zeitplaene der E-Mail-Konten (Ortszeit statt UTC).
TIMEZONE = "Europe/Berlin"

# ---- PIN-Schutz ----
# In der Native-Version aktiviert der Installer den PIN per Default und
# generiert einen 6-stelligen Code, der dem User direkt nach Installation
# angezeigt wird.
PIN_ENABLED = true
PIN_CODE = "<vom Installer generiert>"
PIN_SESSION_TIMEOUT_MINUTES = 1440

# ---- ChromaDB / RAG ----
# Native: embedded. Chroma laeuft als PersistentClient im Backend-Prozess —
# kein separater Service mehr.
CHROMADB_MODE = "embedded"
CHROMADB_PATH = "C:/Users/<USER>/Documents/Zettelwirtschaft/data/chromadb"
# Default qwen3-embedding:4b; bei weniger als 12 GB RAM qwen3-embedding:0.6b.
# Bisheriger Default (bis v1.5): bge-m3. Ein Wechsel baut den Vektor-Index beim
# naechsten Start automatisch neu auf (eigene Collection pro Modell).
EMBEDDING_MODEL = "qwen3-embedding:4b"

RAG_CHUNK_SIZE = 800
RAG_CHUNK_OVERLAP = 150
RAG_TOP_K = 5
RAG_USE_RERANKER = false

LLM_USE_VERIFIER = false
LLM_VERIFIER_THRESHOLD = 0.5

# ---- Update-Pruefung (opt-in, telemetriefrei) ----
# Standardmaessig AUS. Erst nach Aktivierung in den Einstellungen wird das
# Manifest abgerufen (nur die Abfrage selbst, keine Nutzungsdaten).
UPDATE_CHECK_ENABLED = false
UPDATE_MANIFEST_URL = "https://zettelwirtschaft.mr-development.de/latest.json"

# ---- E-Mail-Anbindung ----
# Fernet-Key fuer IMAP-Passwoerter (vom Installer kryptografisch generiert).
EMAIL_ENCRYPTION_KEY = "<vom Installer generiert>"
